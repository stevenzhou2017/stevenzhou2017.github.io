    // Get a list of strings from a YAML sequence node
    // e.g. config YAML: classes:
  - cat
  - dog  -> returns {"cat", "dog"}
    std::vector<std::string> getStringList(const std::string& key,
                                           const std::vector<std::string>& defaultVal = {}) const;
```

- [ ] **Step 1.2: Add implementation to .cpp**

In core/src/aitoolkit/common/ConfigManager.cpp, add after the getBool implementation (after line 41):

```cpp
std::vector<std::string> ConfigManager::getStringList(
    const std::string& key,
    const std::vector<std::string>& defaultVal) const {
    auto node = getNode(key);
    if (!node || !node.IsSequence()) {
        return defaultVal;
    }
    std::vector<std::string> result;
    for (const auto& item : node) {
        result.push_back(item.as<std::string>());
    }
    return result;
}
```

